# Public contact address shown in the footer for reporting outdated information.
# Must be a real, monitored mailbox before going live.
PUBLIC_CONTACT_EMAIL=corrections@example.org

# Optional: Cloudflare Web Analytics site token (manual beacon).
# Prefer automatic injection from the Cloudflare dashboard when the domain
# is orange-cloud proxied — then leave this unset.
# PUBLIC_CF_WEB_ANALYTICS_TOKEN=

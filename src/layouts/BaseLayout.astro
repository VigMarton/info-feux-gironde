---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TriageNav from "../components/TriageNav.astro";
import TrustBanner from "../components/TrustBanner.astro";
import meta from "../content/site/meta.json";
import { locales, t, type Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {siteUrl && locales.map((loc) => (
      <link rel="alternate" hreflang={loc} href={`${siteUrl}/${loc}/`} />
    ))}
    {siteUrl && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/fr/`} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "a11y.skipToContent")}</a>
    <header class="site-header">
      <TrustBanner locale={locale} lastFullCheck={meta.lastFullCheck} />
      <div class="site-header__row">
        <a class="brand" href={`/${locale}/`}>{t(locale, "site.title")}</a>
        <LanguageSwitcher locale={locale} />
      </div>
    </header>
    <TriageNav locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>
      // Progressive enhancement: adds "(12 min ago)" next to the absolute
      // verified timestamp already rendered server-side, so staleness is
      // obvious to readers too, not just editors. Never the only signal —
      // the absolute time and source link always remain.
      type RelativeLabels = {
        justNow: string;
        minutesAgo: (n: number) => string;
        hoursAgo: (n: number) => string;
      };

      const RELATIVE_LABELS: Record<string, RelativeLabels> = {
        fr: { justNow: "à l'instant", minutesAgo: (n) => `il y a ${n} min`, hoursAgo: (n) => `il y a ${n} h` },
        en: { justNow: "just now", minutesAgo: (n) => `${n} min ago`, hoursAgo: (n) => `${n}h ago` },
        es: { justNow: "justo ahora", minutesAgo: (n) => `hace ${n} min`, hoursAgo: (n) => `hace ${n} h` },
        de: { justNow: "gerade eben", minutesAgo: (n) => `vor ${n} Min.`, hoursAgo: (n) => `vor ${n} Std.` },
        nl: { justNow: "net nu", minutesAgo: (n) => `${n} min geleden`, hoursAgo: (n) => `${n} u geleden` },
      };

      const langCode = document.documentElement.lang.split("-")[0];
      const labels = RELATIVE_LABELS[langCode] ?? RELATIVE_LABELS.en;

      function relativeLabel(iso: string): string {
        const then = new Date(iso).getTime();
        if (Number.isNaN(then)) return "";
        const minutes = Math.max(0, Math.round((Date.now() - then) / 60000));
        if (minutes < 1) return labels.justNow;
        if (minutes < 60) return labels.minutesAgo(minutes);
        const hours = Math.round(minutes / 60);
        return labels.hoursAgo(hours);
      }

      function updateRelativeTimes(): void {
        for (const el of document.querySelectorAll<HTMLElement>(".source-meta__relative[data-verified-at]")) {
          el.textContent = relativeLabel(el.dataset.verifiedAt ?? "");
        }
      }

      updateRelativeTimes();
      setInterval(updateRelativeTimes, 60_000);
    </script>
  </body>
</html>

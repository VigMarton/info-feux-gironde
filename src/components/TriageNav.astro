---
import { t, type Locale } from "../i18n";
import { localePath, type PageSegment } from "../lib/routes";

interface Props {
  locale: Locale;
  pathSegment?: PageSegment;
}

const { locale, pathSegment = "" } = Astro.props;

const items = [
  { segment: "situation" as PageSegment, key: "triage.situation" },
  { segment: "evacuation" as PageSegment, key: "triage.evacuation" },
  { segment: "help" as PageSegment, key: "triage.help" },
  { segment: "other" as PageSegment, key: "triage.other" },
] as const;
---

<nav class="triage-nav" aria-label={t(locale, "triage.ariaLabel")}>
  <p class="triage-nav__prompt">{t(locale, "triage.title")}</p>
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            href={localePath(locale, item.segment)}
            class:list={[{ "is-active": pathSegment === item.segment }]}
            aria-current={pathSegment === item.segment ? "page" : undefined}
          >
            {t(locale, item.key)}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

---
import { localeName, locales, t, type Locale } from "../i18n";
import { localePath, type PageSegment } from "../lib/routes";

interface Props {
  locale: Locale;
  pathSegment?: PageSegment;
}

const { locale, pathSegment = "" } = Astro.props;
const others = locales.filter((candidate) => candidate !== locale);
---

<nav class="lang-switch" aria-label={t(locale, "language.ariaLabel")}>
  <ul>
    {
      others.map((candidate) => (
        <li>
          <a class="lang-switch__link" href={localePath(candidate, pathSegment)}>
            {localeName[candidate]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
